{
  "expo": {
    "name": "EventFlow",
    "slug": "eventflow",
    "scheme": "eventflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/eventflow-mark.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eventflow.mobile"
    },
    "android": {
      "package": "com.eventflow.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F5F1E9",
        "foregroundImage": "./assets/eventflow-mark.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/eventflow-mark.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-camera",
        {
          "cameraPermission": "EventFlow necesita la cámara para validar pases QR del evento.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "EventFlow necesita agregar actividades a tu calendario cuando tú lo solicites."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EventFlow necesita acceder a las fotos que decidas compartir en la galería del evento.",
          "cameraPermission": "EventFlow necesita la cámara cuando eliges tomar una foto para compartir.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
